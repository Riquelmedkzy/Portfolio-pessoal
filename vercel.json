{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "riquelmedev.vercel.app"
        }
      ],
      "destination": "https://matheus-riquelme-web.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "riquelmedev.vercel.app"
        }
      ],
      "destination": "https://matheus-riquelme-web.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/processo.html",
      "destination": "/servicos.html",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sobre.php",
      "destination": "/sobre.html",
      "permanent": true
    },
    {
      "source": "/projetos.php",
      "destination": "/projetos.html",
      "permanent": true
    },
    {
      "source": "/habilidades.php",
      "destination": "/habilidades.html",
      "permanent": true
    },
    {
      "source": "/contato.php",
      "destination": "/contato.html",
      "permanent": true
    },
    {
      "source": "/processo.php",
      "destination": "/servicos.html",
      "permanent": true
    },
    {
      "source": "/projeto.php",
      "destination": "/projeto.html",
      "permanent": true
    },
    {
      "source": "/demo.php",
      "destination": "/projeto.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-yDpGZjC9iI2lmTo8eU4KzC6LTE50JZ2gnd/YT7ArioU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
